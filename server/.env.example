PORT=8787
DB_PATH=./data/gamely.db

# Optional: Nintendo Americas catalog (US, CA, MX, BR, AR, CL, CO, PE).
# Leave blank and the server skips the Americas rather than guessing.
NA_SEARCH_APP_ID=
NA_SEARCH_API_KEY=
NA_SEARCH_INDEX=store_game_en_us

# Optional: Expo enhanced push security (expo.dev > Access tokens)
EXPO_ACCESS_TOKEN=

# Check intervals in minutes (defaults shown)
# EVERY_HOT_MIN=10
# EVERY_DEALS_MIN=20
# EVERY_SALE_MIN=30
# EVERY_CATALOG_MIN=720
# EVERY_SWEEP_MIN=1440
