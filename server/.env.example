PORT=8787
DB_PATH=./data/gamely.db

# Nintendo Americas catalog (US, CA, MX, BR, AR, CL, CO, PE). On by default,
# using the search key Nintendo's US store page uses. Set AMERICAS=off to
# leave the Americas out, or fill in other search credentials below.
# AMERICAS=off
NA_SEARCH_APP_ID=
NA_SEARCH_API_KEY=
NA_SEARCH_INDEX=store_game_en_us

# Optional: Expo enhanced push security (expo.dev > Access tokens)
EXPO_ACCESS_TOKEN=

# Check intervals in minutes (defaults shown)
# EVERY_HOT_MIN=10
# EVERY_DEALS_MIN=20
# EVERY_SALE_MIN=30
# EVERY_CATALOG_MIN=720
# EVERY_SWEEP_MIN=1440
# EVERY_EVENTS_MIN=30
# EVERY_BIG_DEALS_MIN=180

# Set to 1 only when running behind a proxy you control (Fly, Render, a load
# balancer) that sets X-Forwarded-For. Otherwise clients could fake their address.
TRUST_PROXY=0
# Most games one install can watch
MAX_WATCHES=300
